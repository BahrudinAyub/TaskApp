<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Back Icon and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:padding="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_back_new"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goals"
            android:textSize="20sp"
            android:layout_gravity="center_vertical"
            android:textColor="@color/black"
            android:paddingStart="8dp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:src="@drawable/ic_target"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- Target Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/background_target"
        android:padding="16dp"
        android:layout_marginTop="16dp">

        <!-- Circular Progress (You can customize it with a library or custom view) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/progress_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="16sp"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/nama_target_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pergi Liburan"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/deskripsi_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rencana liburan jangka panjang"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tanggal_selesai_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Berakhir: 15 Okt 2024"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/add_tugas"
                android:contentDescription="Add target"
                android:layout_gravity="center_vertical" />
        </LinearLayout>
    </LinearLayout>

    <!-- Target Section with Plus Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/target_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Target"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/add_tugas"
            android:contentDescription="Add Target"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/no_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Belum ada target"
        android:textSize="14sp"
        android:textColor="@color/gray_text"
        android:layout_marginTop="4dp" />

</LinearLayout>
