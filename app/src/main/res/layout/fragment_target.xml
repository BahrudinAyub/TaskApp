<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <!-- Back Icon and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:padding="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_back_new"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goals"
            android:textSize="20sp"
            android:layout_gravity="center_vertical"
            android:textColor="@color/black"
            android:paddingStart="8dp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:src="@drawable/ic_target"
            android:contentDescription="Menu" />
    </LinearLayout>

    <!-- Target Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/background_target"
        android:padding="16dp"
        android:layout_marginTop="16dp">

        <!-- Circular Progress (You can customize it with a library or custom view) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/progress_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="16sp"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/nama_target_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pergi Liburan"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/deskripsi_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rencana liburan jangka panjang"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tanggal_selesai_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Berakhir: 15 Okt 2024"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/add_tugas"
                android:contentDescription="Add target"
                android:layout_gravity="center_vertical" />
        </LinearLayout>
    </LinearLayout>

    <!-- Target Section with Plus Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/target_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Target"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/fl_add_target"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_background_blue"
        android:layout_marginStart="8dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/add_tugas"
            android:backgroundTint="@color/black"
            android:contentDescription="Add Target"
            android:layout_gravity="center_vertical" />
    </FrameLayout>

</LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <!-- Card 1: Menabung 500.000 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card_background"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_target_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menabung 500.000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_progress_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="IDR 0/500.000"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/gray_text" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mode_jangan_ganggu"
                    android:contentDescription="Menu" />
            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_bar_1"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:progressDrawable="@drawable/progress_bar_style"
                android:progress="0" />
        </LinearLayout>

        <!-- Card 2: Mencari Referensi Travel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/rounded_card_background"
            android:padding="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_target_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mencari Referensi Travel"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_progress_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="2/5"
                    android:textSize="12sp"
                    android:layout_weight="1"
                    android:textColor="@color/gray_text" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_mode_jangan_ganggu"
                    android:contentDescription="Menu" />
            </LinearLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_bar_2"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:progressDrawable="@drawable/progress_bar_style"
                android:progress="40" />
        </LinearLayout>

    </LinearLayout>
    <TextView
        android:id="@+id/tv_riwayat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Riwayat"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="8dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_card_background"
        android:padding="16dp">



        <!-- Item 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tv_riwayat_item_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mencari Referensi Travel"
                android:textSize="14sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/badge_riwayat_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+2"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:gravity="center"
                android:background="@drawable/rounded_badget_green"
                android:padding="4dp"
                android:minWidth="32dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_button" />

        <!-- Item 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tv_riwayat_item_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Menabung 500.000"
                android:textSize="14sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_date_riwayat_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dibuat: 8 Okt 24"
                android:textColor="@color/gray_text"
                android:background="@drawable/rounded_background_gray"
                android:textSize="12sp"
                android:padding="4dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_button" />

        <!-- Item 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp"
            android:paddingTop="8dp">

            <TextView
                android:id="@+id/tv_riwayat_item_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mencari Referensi Travel"
                android:textSize="14sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/tv_date_riwayat_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dibuat: 6 Okt 24"
                android:textColor="@color/gray_text"
                android:background="@drawable/rounded_background_gray"
                android:textSize="12sp"
                android:padding="4dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>


</LinearLayout>
